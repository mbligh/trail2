#!/usr/bin/env python3
"""Replay an already compiled iOS probe for diagnostics; does not replace its smoke test."""
import base64
import io
import json
from pathlib import Path
import shutil
import subprocess
import time
from PIL import Image

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / 'experiments/ios-map/build/replay'
OUT.mkdir(parents=True, exist_ok=True)
APP = ROOT / 'experiments/ios-map/build/TrailIosProbe.app'

def run(*args, **kwargs):
    return subprocess.run(args, check=True, timeout=180, **kwargs)

devices = json.loads(subprocess.check_output(
    ['xcrun', 'simctl', 'list', 'devices', 'available', '--json'], timeout=90))
phones = [d for runtime, values in devices['devices'].items() if '.iOS-' in runtime
          for d in values if d.get('isAvailable') and 'iPhone' in d['name']]
if not phones:
    raise RuntimeError('No iPhone simulator')
phone = next((d for d in phones if d['state'] == 'Booted'), phones[0])
identifier = phone['udid']
if phone['state'] != 'Booted':
    run('xcrun', 'simctl', 'boot', identifier)
run('xcrun', 'simctl', 'bootstatus', identifier, '-b')
run('xcrun', 'simctl', 'install', identifier, str(APP))

console_path = OUT / 'console.txt'
console = console_path.open('w')
process = subprocess.Popen(
    ['xcrun', 'simctl', 'launch', '--terminate-running-process', '--console',
     identifier, 'net.pocketmap.iosprobe', '--metal-probe'],
    stdout=console, stderr=subprocess.STDOUT)
screenshot = OUT / 'ios-replay.png'
try:
    for attempt in range(20):
        time.sleep(3)
        run('xcrun', 'simctl', 'io', identifier, 'screenshot', str(screenshot))
        image = Image.open(screenshot).convert('RGB')
        pixels = list(image.crop((0, image.height // 5, image.width, image.height * 4 // 5)).getdata())
        counts = {
            'red': sum(r > 210 and g < 70 and b < 70 for r, g, b in pixels),
            'green': sum(g > r + 30 and g > b + 30 for r, g, b in pixels),
            'blue': sum(b > r + 50 and b > g + 35 for r, g, b in pixels),
        }
        print('Replay rendering:', counts, 'console process:', process.poll(), flush=True)
        (OUT / 'render-counts.json').write_text(json.dumps(counts, indent=2))
        if process.poll() is not None or all(counts[c] > 150 for c in counts):
            break
finally:
    # Inspect the launch failure before cleanup. The simctl --console wrapper
    # can remain alive after the application exits, and simctl terminate can hang.
    with (OUT / 'app-log.txt').open('w') as log:
        try:
            subprocess.run(
                ['xcrun', 'simctl', 'spawn', identifier, 'log', 'show',
                 '--last', '12m', '--style', 'compact', '--predicate',
                 'process == "TrailIosProbe" OR eventMessage CONTAINS[c] "iosprobe"'],
                stdout=log, stderr=subprocess.STDOUT, timeout=75, check=False)
        except subprocess.TimeoutExpired:
            log.write('simctl log show timed out\n')
    reports = []
    for directory in (Path.home() / 'Library/Logs/DiagnosticReports',
                      Path.home() / 'Library/Developer/CoreSimulator/Devices' /
                      identifier / 'data/Library/Logs/DiagnosticReports'):
        if directory.exists():
            reports.extend(directory.glob('TrailIosProbe*'))
    for report in sorted(reports, key=lambda p: p.stat().st_mtime)[-4:]:
        shutil.copy2(report, OUT / report.name)
        print('IOS_CRASH_REPORT_BEGIN\n' + report.read_text(errors='replace')[:100000] +
              '\nIOS_CRASH_REPORT_END', flush=True)
    try:
        subprocess.run(['xcrun', 'simctl', 'terminate', identifier, 'net.pocketmap.iosprobe'],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15, check=False)
    except subprocess.TimeoutExpired:
        print('WARNING: simctl terminate timed out after launch failure', flush=True)
    try:
        process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=5)
    console.close()
    print('IOS_CONSOLE_BEGIN\n' + console_path.read_text(errors='replace')[-100000:] +
          '\nIOS_CONSOLE_END', flush=True)
    app_log = (OUT / 'app-log.txt').read_text(errors='replace')
    print('IOS_SYSTEM_LOG_BEGIN\n' + app_log[-50000:] + '\nIOS_SYSTEM_LOG_END', flush=True)
    if screenshot.exists():
        image = Image.open(screenshot).convert('RGB')
        image.thumbnail((480, 960))
        buffer = io.BytesIO()
        image.save(buffer, format='PNG')
        print('IOS_RENDER_PNG_BASE64:' + base64.b64encode(buffer.getvalue()).decode(), flush=True)
