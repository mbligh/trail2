#!/usr/bin/env python3
"""Check 64-bit ELF load segments in an Android APK/AAB for 16 KiB devices."""
import struct
import sys
import zipfile


def check(path):
    checked = 0
    with zipfile.ZipFile(path) as archive:
        for entry in archive.infolist():
            if not entry.filename.endswith('.so') or not any(
                '/lib/' + abi + '/' in '/' + entry.filename
                for abi in ('arm64-v8a', 'x86_64')
            ):
                continue
            data = archive.read(entry)
            if data[:6] != b'\x7fELF\x02\x01':
                raise ValueError(f'{entry.filename}: expected little-endian ELF64')
            offset = struct.unpack_from('<Q', data, 32)[0]
            size, count = struct.unpack_from('<HH', data, 54)
            if size < 56 or not count:
                raise ValueError(f'{entry.filename}: invalid program headers')
            loads = 0
            for index in range(count):
                header = offset + index * size
                kind, _, file_offset, address, _, _, _, alignment = struct.unpack_from('<IIQQQQQQ', data, header)
                if kind == 1:  # PT_LOAD
                    loads += 1
                    if alignment < 16384 or alignment & (alignment - 1) or (address - file_offset) % 16384:
                        raise ValueError(f'{entry.filename}: segment {index} is not 16 KiB aligned')
            if not loads:
                raise ValueError(f'{entry.filename}: missing load segments')
            checked += 1
            print(f'16 KiB ELF alignment OK: {entry.filename}')
    if not checked:
        raise ValueError('No 64-bit native libraries found')
    print(f'Checked {checked} native libraries in {path}')


if __name__ == '__main__':
    check(sys.argv[1])
