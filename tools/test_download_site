#!/usr/bin/env python3
"""Regression checks for preserving independent Android and iOS downloads."""
import hashlib
import importlib.machinery
import importlib.util
import io
import json
from pathlib import Path
import plistlib
import tempfile
import unittest
import urllib.error
import zipfile

loader = importlib.machinery.SourceFileLoader('downloads', str(Path(__file__).with_name('prepare_download_site')))
spec = importlib.util.spec_from_loader(loader.name, loader)
downloads = importlib.util.module_from_spec(spec)
loader.exec_module(downloads)
REPO = 'mbligh/trail2'


def zip_bytes(files):
    result = io.BytesIO()
    with zipfile.ZipFile(result, 'w') as archive:
        for name, value in files.items():
            archive.writestr(name, value)
    return result.getvalue()


def ipa(version, mode='release'):
    return zip_bytes({'Payload/Trail2.app/Info.plist':plistlib.dumps(dict(CFBundleIdentifier='mbligh.trail',
        CFBundleShortVersionString=version, MinimumOSVersion='18.5', TrailBuildConfiguration=mode)),
        'Payload/Trail2.app/TrailIosProbe':b'fixture native executable'})


class Fixtures:
    def __init__(self):
        self.runs = {}
        self.artifacts = {}
        self.files = {}
        self.public = {}
    def add(self, platform, run_id, content, legacy=False, expired=False):
        workflow, names, filename = downloads.PLATFORMS[platform]
        run = dict(id=run_id, conclusion='success', head_branch='main', event='push', head_sha=str(run_id),
                   head_repository={'full_name':REPO})
        self.runs.setdefault(workflow, []).insert(0, run)
        self.artifacts[run_id] = [dict(id=run_id, name=names[-1] if legacy else names[0], expired=expired, created_at=str(run_id))]
        self.files[run_id] = zip_bytes({('experiments/ios-map/build/' if legacy else '')+filename:content,
                                      'unrelated.txt':b'do not publish diagnostics'})
    def get(self, path):
        if '/actions/workflows/' in path:
            return {'workflow_runs':self.runs[path.split('/workflows/')[1].split('/')[0]]}
        if path.endswith('/pages'):
            return {'html_url':'https://example.invalid/trail2/'}
        return {'artifacts':self.artifacts[int(path.split('/runs/')[1].split('/')[0])]}
    def fetch(self, repository, artifact, output):
        assert repository == REPO
        output.write_bytes(self.files[artifact['id']])
    def open_public(self, url, timeout):
        name = url.rsplit('/',1)[1]
        if name not in self.public:
            raise urllib.error.HTTPError(url,404,'Not found',{},None)
        return io.BytesIO(self.public[name])
    def prepare(self, output):
        return downloads.prepare(REPO, output, self.get, self.fetch,
            template='iOS {{IOS_VERSION}}, minimum {{IOS_MINIMUM_OS}}', public_open=self.open_public)


class DownloadSiteTests(unittest.TestCase):
    def fixtures(self):
        f = Fixtures()
        f.add('android', 100, b'original apk')
        f.add('ios', 200, ipa('2.0.22'), legacy=True)
        return f
    def test_each_platform_updates_without_erasing_or_rolling_back_the_other(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            f = self.fixtures()
            first = f.prepare(root/'first')
            self.assertEqual((root/'first/Trail2.apk').read_bytes(), b'original apk')
            self.assertEqual((root/'first/Trail2-device-unsigned.ipa').read_bytes(), ipa('2.0.22'))
            f.add('ios', 201, ipa('2.0.23'))
            second = f.prepare(root/'second')
            self.assertEqual(second['android'], first['android'])
            self.assertEqual(second['ios']['version'], '2.0.23')
            f.add('android', 101, b'new apk')
            third = f.prepare(root/'third')
            self.assertEqual(third['ios'], second['ios'])
            self.assertEqual((root/'third/Trail2.apk').read_bytes(), b'new apk')
            self.assertEqual(third['android']['sha256'], hashlib.sha256(b'new apk').hexdigest())
            self.assertEqual((root/'third/index.html').read_text(), 'iOS 2.0.23, minimum 18.5')
            self.assertFalse((root/'third/unrelated.txt').exists())
    def test_expired_artifact_preserves_verified_public_copy_instead_of_older_build(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            f = self.fixtures()
            f.prepare(root/'published')
            f.public = {p.name:p.read_bytes() for p in (root/'published').iterdir() if p.is_file()}
            f.artifacts[200][0]['expired'] = True
            # Retained but older: it must never replace the newer public IPA.
            f.add('ios', 199, ipa('2.0.21'))
            f.runs['ios-smoke.yml'].reverse()
            f.add('android', 101, b'new apk')
            metadata = f.prepare(root/'updated')
            self.assertEqual(metadata['ios']['run_id'], 200)
            self.assertEqual(metadata['ios']['version'], '2.0.22')
            self.assertEqual((root/'updated/Trail2.apk').read_bytes(), b'new apk')
            f.public['Trail2-device-unsigned.ipa'] += b'corrupt'
            with self.assertRaises(ValueError):
                f.prepare(root/'invalid')
            self.assertFalse((root/'invalid').exists())
            altered = bytearray((root/'published/Trail2-device-unsigned.ipa').read_bytes())
            altered[-1] ^= 1
            f.public['Trail2-device-unsigned.ipa'] = bytes(altered)
            with self.assertRaisesRegex(ValueError, 'checksum'):
                f.prepare(root/'corrupt')
            self.assertFalse((root/'corrupt').exists())
    def test_rejects_debug_ipa_and_untrusted_runs_without_touching_existing_output(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            f = self.fixtures()
            f.add('ios', 201, ipa('2.0.23', mode='debug'))
            existing = root/'site'
            existing.mkdir()
            (existing/'previous').write_text('keep')
            with self.assertRaises(ValueError):
                f.prepare(existing)
            self.assertEqual((existing/'previous').read_text(), 'keep')
            for change in [dict(event='pull_request'), dict(head_branch='feature'),
                           dict(conclusion='failure'), dict(head_repository={'full_name':'other/fork'})]:
                f = self.fixtures()
                f.add('ios', 201, ipa('bad'))
                f.runs['ios-smoke.yml'][0].update(change)
                metadata = f.prepare(root/str(next(iter(change))))
                self.assertEqual(metadata['ios']['version'], '2.0.22')
    def test_rerun_of_successful_build_cannot_roll_back_a_newer_public_copy(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            f = self.fixtures()
            f.add('ios', 201, ipa('2.0.23'))
            first = f.prepare(root/'published')
            f.public = {p.name:p.read_bytes() for p in (root/'published').iterdir() if p.is_file()}
            # A rerun is in progress, so the REST success filter only returns 200.
            f.runs['ios-smoke.yml'] = [r for r in f.runs['ios-smoke.yml'] if r['id'] != 201]
            f.add('android', 101, b'new apk')
            second = f.prepare(root/'updated')
            self.assertEqual(second['ios'], first['ios'])
            self.assertEqual(second['android']['run_id'], 101)
            self.assertEqual((root/'updated/Trail2-device-unsigned.ipa').read_bytes(), ipa('2.0.23'))

    def test_duplicate_archive_file_is_rejected(self):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory)
            archive = path/'bad.zip'
            archive.write_bytes(zip_bytes({'one/Trail2.apk':b'a', 'two/Trail2.apk':b'b'}))
            with self.assertRaises(ValueError):
                downloads.extract(archive, path/'out', 'Trail2.apk')


if __name__ == '__main__':
    unittest.main()
