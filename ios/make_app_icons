#!/usr/bin/env python3
"""Render the existing Android vector icon into an iOS asset catalog."""
import json
from pathlib import Path
import re
import sys
import xml.etree.ElementTree as ET
from PIL import Image, ImageChops, ImageDraw

ROOT = Path(__file__).resolve().parent.parent
catalog = Path(sys.argv[1])
output = catalog / 'AppIcon.appiconset'
output.mkdir(parents=True, exist_ok=True)
android = '{http://schemas.android.com/apk/res/android}'
vector = ET.parse(ROOT / 'app/src/main/res/drawable/ic_launcher_foreground.xml').getroot()
group = vector.find('group')
scale = 1024 / float(vector.attrib[android+'viewportWidth'])
sx,sy = (float(group.attrib[android+k]) for k in ('scaleX','scaleY'))
tx,ty = (float(group.attrib[android+k]) for k in ('translateX','translateY'))
canvas = Image.new('RGB',(1024,1024),'white')
for path in group.findall('path'):
    assert path.attrib[android+'fillType'] == 'evenOdd'
    tokens = re.findall(r'[A-Za-z]|-?\d+(?:\.\d+)?',path.attrib[android+'pathData'])
    mask = Image.new('1',canvas.size)
    polygon = []
    index = 0
    while index < len(tokens):
        command = tokens[index]
        if command in ('M','L'):
            index += 1
            polygon.append(((float(tokens[index])*sx+tx)*scale,(float(tokens[index+1])*sy+ty)*scale))
            index += 2
        elif command == 'Z':
            layer = Image.new('1',canvas.size)
            ImageDraw.Draw(layer).polygon(polygon,fill=1)
            mask = ImageChops.logical_xor(mask,layer)
            polygon = []
            index += 1
        else: raise ValueError('Unsupported icon path command: '+command)
    assert not polygon, 'Unclosed vector path'
    canvas.paste(path.attrib[android+'fillColor'],(0,0),mask)
canvas.save(output / 'AppIcon.png')
(output / 'Contents.json').write_text(json.dumps({'images':[{'filename':'AppIcon.png','idiom':'universal','platform':'ios','size':'1024x1024'}],'info':{'author':'xcode','version':1}}))
(catalog / 'Contents.json').write_text(json.dumps({'info':{'author':'xcode','version':1}}))
