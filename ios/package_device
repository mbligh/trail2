#!/usr/bin/env python3
"""Package the validated unsigned Release device host with the Trail 2 app identity.

This is a development device package. It still needs Apple provisioning and
signing before installation and is not an App Store submission archive.
"""
import hashlib
import os
from pathlib import Path
import plistlib
import re
import shutil
import stat
import subprocess
import tempfile
import zipfile

ROOT = Path(__file__).resolve().parent.parent
source = ROOT / 'experiments/ios-map/build/TrailIosProbe-device.app'
output = ROOT / 'experiments/ios-map/build/Trail2-device-unsigned.ipa'
version = re.search(r'versionName = "([0-9.]+)"',(ROOT / 'app/build.gradle.kts').read_text()).group(1)
original = plistlib.loads((source / 'Info.plist').read_bytes())
assert original['CFBundleSupportedPlatforms'] == ['iPhoneOS']
assert original['MinimumOSVersion'] == '18.5'
assert original.get('TrailBuildConfiguration') == 'release', 'Build the device host with Release frameworks and Swift -O first'
assert not (source / 'mapAssets/maps/ios-contours.pmtiles').exists(), 'Simulator fixture leaked into device package'
assert not (source / 'embedded.mobileprovision').exists(), 'Expected unsigned input'
binary = source / original['CFBundleExecutable']
build = subprocess.check_output(['xcrun','vtool','-show-build',str(binary)],text=True)
assert re.search(r'platform\s+IOS\s',build), build
assert re.search(r'minos\s+18\.5\s',build), build
with tempfile.TemporaryDirectory() as temporary:
    root = Path(temporary)
    app = root / 'Payload/Trail2.app'
    shutil.copytree(source,app)
    shutil.rmtree(app / '_CodeSignature',ignore_errors=True)
    info = dict(original,CFBundleIdentifier='mbligh.trail',CFBundleName='Trail 2',
                CFBundleDisplayName='Trail 2',CFBundleShortVersionString=version,
                CFBundleVersion=os.environ.get('GITHUB_RUN_NUMBER','1'))
    assert info['CFBundleVersion'].isdigit()
    assert 'location' in info['UIBackgroundModes']
    assert info['CFBundleIcons']['CFBundlePrimaryIcon']['CFBundleIconName'] == 'AppIcon'
    (app / 'Info.plist').write_bytes(plistlib.dumps(info))
    assert hashlib.sha256(binary.read_bytes()).digest() == hashlib.sha256((app / info['CFBundleExecutable']).read_bytes()).digest()
    with zipfile.ZipFile(output,'w',compression=zipfile.ZIP_DEFLATED) as archive:
        for file in sorted(app.rglob('*')):
            if file.is_file(): archive.write(file,file.relative_to(root))
with zipfile.ZipFile(output) as archive:
    executable = archive.getinfo('Payload/Trail2.app/'+info['CFBundleExecutable'])
    assert (executable.external_attr >> 16) & stat.S_IXUSR, 'Executable permission lost'
    assert plistlib.loads(archive.read('Payload/Trail2.app/Info.plist')) == info
    assert archive.testzip() is None
assert plistlib.loads((source / 'Info.plist').read_bytes()) == original
print(f'Validated unsigned Trail 2 {version} device package: {output.name}',flush=True)
