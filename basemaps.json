  "overlays": [
    {
      "id": "contours",
      "name": "NJ contours (100\u201310 ft)",
      "sources": {
        "nj-contours": {
          "type": "vector",
          "url": "pmtiles://https://mapping.mbligh.org/contours.pmtiles",
          "attribution": "Contours derived from NJOGIS statewide DEM"
        }
      },
      "layers": [
        {
          "id": "nj-contour-lines-100",
          "type": "line",
          "source": "nj-contours",
          "source-layer": "contours",
          "minzoom": 9,
          "filter": [
            "==",
            [
              "%",
              [
                "get",
                "elevation_ft"
              ],
              100
            ],
            0
          ],
          "paint": {
            "line-color": "#ff00dc",
            "line-opacity": 0.9,
            "line-width": [
              "case",
              [
                "==",
                [
                  "%",
                  [
                    "get",
                    "elevation_ft"
                  ],
                  100
                ],
                0
              ],
              2.2,
              1.25
            ]
          },
          "maxzoom": 12
        },
        {
