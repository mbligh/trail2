{
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "archive": "maps/tewksbury-streets.mbtiles",
      "cacheVersion": "openfreemap-openmaptiles-v1",
      "attribution": "\u00a9 OpenFreeMap \u00b7 \u00a9 OpenMapTiles \u00b7 \u00a9 OpenStreetMap contributors"
    },
    "ne2_shaded": {
      "type": "raster",
      "tileSize": 256,
      "maxzoom": 6,
      "tiles": [
        "https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"
      ],
      "archive": "maps/tewksbury-earth.mbtiles",
      "attribution": "Natural Earth"
    },
    "nj-orthos": {
      "type": "raster",
      "tileSize": 256,
      "maxzoom": 20,
      "tiles": [
        "https://maps.nj.gov/arcgis/rest/services/Basemap/Orthos_Natural_2020_NJ_WM/MapServer/tile/{z}/{y}/{x}"
      ],
      "archive": "maps/njsatellite.mbtiles",
      "attribution": "2020 aerial imagery \u00b7 NJOIT Office of GIS"
    },
    "osm-raster": {
      "type": "raster",
      "tileSize": 256,
      "maxzoom": 19,
      "tiles": [
        "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      ],
      "archive": "maps/openstreetmap.mbtiles",
      "attribution": "\u00a9 OpenStreetMap contributors"
    },
    "topo-raster": {
      "type": "raster",
      "tileSize": 256,
      "maxzoom": 17,
      "tiles": [
        "https://a.tile.opentopomap.org/{z}/{x}/{y}.png"
      ],
      "archive": "maps/opentopomap.mbtiles",
      "attribution": "\u00a9 OpenStreetMap contributors, SRTM \u00b7 \u00a9 OpenTopoMap (CC BY-SA 3.0)"
    }
  },
  "basemaps": [
    {
      "name": "bright",
