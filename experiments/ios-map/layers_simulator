#!/usr/bin/env python3
"""Real range HTTP + common PMTiles decoder + Metal contours, hide/show and offline relaunch."""
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from io import BytesIO
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import threading
import time
from PIL import Image

ROOT = Path(__file__).resolve().parent
OUT = ROOT / 'build/smoke'
spec = importlib.util.spec_from_file_location('contour_fixture', ROOT.parent / 'maplibre-compose/tools/make_contour_fixture.py')
fixture = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fixture)
path = OUT / 'ios-contour-fixture.pmtiles'
fixture.make(path, update_assets=False)
ARCHIVE = path.read_bytes()
buffer = BytesIO()
Image.new('RGB',(256,256),(240,235,215)).save(buffer,'PNG')
RASTER = buffer.getvalue()


class Handler(BaseHTTPRequestHandler):
    requests = 0
    ranges = 0
    def do_GET(self):
        Handler.requests += 1
        if self.path == '/contours.pmtiles':
            Handler.ranges += 1
            match = re.fullmatch(r'bytes=(\d+)-(\d+)',self.headers.get('Range',''))
            assert match, 'Unbounded archive download'
            start,end = map(int,match.groups())
            assert 0 <= start <= end < len(ARCHIVE)
            assert self.headers.get('If-Range') in (None,'"fixture-v1"')
            body = ARCHIVE[start:end+1]
            self.send_response(206)
            self.send_header('Content-Range',f'bytes {start}-{end}/{len(ARCHIVE)}')
            self.send_header('ETag','"fixture-v1"')
        else:
            body = RASTER
            self.send_response(200)
            self.send_header('Content-Type','image/png')
        self.send_header('Content-Length',str(len(body)))
        self.end_headers()
        self.wfile.write(body)


server = ThreadingHTTPServer(('localhost',0),Handler)
threading.Thread(target=server.serve_forever,daemon=True).start()
devices = json.loads(subprocess.check_output(['xcrun','simctl','list','devices','available','--json'],timeout=60))
identifier = next(d['udid'] for runtime,values in devices['devices'].items() if '.iOS-' in runtime
                  for d in values if 'iPhone' in d['name'] and d['state'] == 'Booted')
try:
    for phase in ('write','read'):
        count = Handler.requests
        output = OUT / f'layers-{phase}-console.txt'
        with output.open('w') as log:
            app = subprocess.Popen(['xcrun','simctl','launch','--terminate-running-process','--console',identifier,
                'net.pocketmap.iosprobe','--layer-self-test',phase,f'http://localhost:{server.server_port}'],stdout=log,stderr=subprocess.STDOUT)
            try:
                deadline = time.monotonic()+180
                disabled = False
                settled = 0
                while time.monotonic() < deadline:
                    if app.poll() is not None:
                        raise RuntimeError(f'Layer app exited: {phase}; see {output}')
                    console = output.read_text(errors='replace')
                    if phase == 'write' and not disabled and 'IOS_LAYER_DISABLED_PASS' in console:
                        # Initial disabled style omits the entire archive source.
                        disabled = True
                    if f'IOS_LAYER_ALL_PASS:{phase}' in console and 'IOS_PMTILES_HIT:' in console:
                        screenshot = OUT / f'layers-{phase}.png'
                        subprocess.run(['xcrun','simctl','io',identifier,'screenshot',str(screenshot)],check=True,timeout=60)
                        image = Image.open(screenshot).convert('RGB')
                        pixels = list(image.crop((0,image.height//5,image.width,image.height*4//5)).getdata())
                        magenta = sum(r > g+60 and b > g+45 and r > 150 for r,g,b in pixels)
                        blue = sum(b > r+50 and b > g+35 for r,g,b in pixels)
                        red = sum(r > g+60 and r > b+60 for r,g,b in pixels)
                        settled = settled+1 if magenta > 1000 and blue > 500 and red > 500 else 0
                        if settled >= 2:
                            if phase == 'write':
                                assert disabled and Handler.ranges > 0
                            else:
                                assert Handler.requests == count, 'Offline relaunch made an HTTP request'
                            print(f'iOS contour/cache/layer passed {phase}: magenta={magenta}, blue={blue}, red={red}',flush=True)
                            break
                    time.sleep(1)
                else:
                    raise AssertionError(f'Layer check failed: {phase}; see {output}')
            finally:
                subprocess.run(['xcrun','simctl','terminate',identifier,'net.pocketmap.iosprobe'],check=False,timeout=30)
                try: app.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    app.terminate(); app.wait(timeout=15)
        print(output.read_text(errors='replace')[-30000:],flush=True)
finally:
    server.shutdown()
