#!/usr/bin/env python3
"""Exercise shared KML import, native HTTP/cache and Metal rendering on iOS."""
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
from pathlib import Path
import subprocess
import threading
import time
from PIL import Image

ROOT = Path(__file__).resolve().parent
OUT = ROOT / 'build/smoke'
OUT.mkdir(parents=True, exist_ok=True)
KML = '''<kml><Document><name>Simulator trails</name>
<Style id="line"><LineStyle><color>ff0000ff</color><width>7</width></LineStyle></Style>
<Folder><name>Trails</name><Placemark><name>Cached trail fixture</name><styleUrl>#line</styleUrl>
<LineString><coordinates>-74.779,40.695 -74.763,40.689</coordinates></LineString></Placemark>'''
for index, icon in enumerate(('1763', '1899', '1205', '503')):
    KML += f'''<Placemark><name>Icon {icon}</name><Style id="icon-{icon}"><IconStyle><color>ff00aa00</color></IconStyle></Style>
<Point><coordinates>{-74.777 + index * .004},40.692</coordinates></Point></Placemark>'''
KML += '</Folder></Document></kml>'


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        body = KML.encode() if self.path == '/valid' else b'<kml>broken'
        self.send_response(503 if self.path == '/offline' else 200)
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)


server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
threading.Thread(target=server.serve_forever, daemon=True).start()
devices = json.loads(subprocess.check_output(['xcrun', 'simctl', 'list', 'devices', 'available', '--json'], timeout=60))
identifier = next(d['udid'] for runtime, values in devices['devices'].items() if '.iOS-' in runtime
                  for d in values if 'iPhone' in d['name'] and d['state'] == 'Booted')
try:
    for phase, path in [('write', 'valid'), ('offline', 'offline'), ('invalid', 'invalid')]:
        output = OUT / f'trails-{phase}-console.txt'
        with output.open('w') as log:
            app = subprocess.Popen(['xcrun', 'simctl', 'launch', '--terminate-running-process', '--console',
                identifier, 'net.pocketmap.iosprobe', '--trail-cache-test', phase,
                f'http://localhost:{server.server_port}/{path}'], stdout=log, stderr=subprocess.STDOUT)
            try:
                deadline = time.monotonic() + 100
                settled = 0
                while time.monotonic() < deadline:
                    if app.poll() is not None:
                        raise RuntimeError(f'Trail integration host exited during {phase}; see {output}')
                    console = output.read_text(errors='replace')
                    if f'TRAIL_CACHE_TEST_PASS:{phase}' in console and 'IOS_TRAIL_RENDER_PASS:' in console:
                        screenshot = OUT / f'trails-{phase}.png'
                        subprocess.run(['xcrun', 'simctl', 'io', identifier, 'screenshot', str(screenshot)], check=True, timeout=60)
                        image = Image.open(screenshot).convert('RGB')
                        pixels = list(image.crop((0, image.height // 5, image.width, image.height * 4 // 5)).getdata())
                        red = sum(r > g + 60 and r > b + 60 for r, g, b in pixels)
                        settled = settled + 1 if red >= 1000 else 0
                        if settled >= 2:
                            print(f'iOS shared KML/cache/render passed {phase}: red={red}', flush=True)
                            break
                    time.sleep(2)
                else:
                    raise AssertionError(f'Trail cache/render failed {phase}; see {output}')
            finally:
                subprocess.run(['xcrun', 'simctl', 'terminate', identifier, 'net.pocketmap.iosprobe'], check=False, timeout=30)
                try:
                    app.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    app.terminate()
                    app.wait(timeout=15)
        print(output.read_text(errors='replace')[-20000:], flush=True)
finally:
    server.shutdown()
    server.server_close()
