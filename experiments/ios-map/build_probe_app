#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/../.."
kind="${1:-simulator}"
case "$kind" in
    simulator)
        target=iosSimulatorArm64
        sdk_name=iphonesimulator
        platform=iPhoneSimulator
        triple=arm64-apple-ios18.5-simulator
        app="experiments/ios-map/build/TrailIosProbe.app"
        ;;
    device)
        target=iosArm64
        sdk_name=iphoneos
        platform=iPhoneOS
        triple=arm64-apple-ios18.5
        app="experiments/ios-map/build/TrailIosProbe-device.app"
        ;;
    *) echo "Usage: $0 [simulator|device]" >&2; exit 2 ;;
esac
framework="experiments/ios-map/build/bin/$target/debugFramework"
mkdir -p "$app"
# Direct swiftc linking does not run Xcode's embedAndSign task. Run the same
# Compose resource sync explicitly so transitive MapLibre strings reach the app.
BUILT_PRODUCTS_DIR="$PWD/$(dirname "$app")" \
UNLOCALIZED_RESOURCES_FOLDER_PATH="$(basename "$app")" \
PLATFORM_NAME="$sdk_name" ARCHS=arm64 \
    ./gradlew --no-daemon :iosProbe:syncComposeResourcesForIos
required_resource="$app/compose-resources/composeResources/org.maplibre.compose.generated/values/strings.commonMain.cvr"
if [ ! -s "$required_resource" ]; then
    echo "Missing MapLibre Compose resource: $required_resource" >&2
    exit 1
fi
# Seed bundle is generated by the same boundary/coverage tool as Android.
test -s experiments/ios-map/build/mapAssets/offline-manifest.json
ditto experiments/ios-map/build/mapAssets "$app/mapAssets"
mkdir -p "$app/trail-icons"
cp app/src/main/res/drawable-nodpi/mymaps_*.png "$app/trail-icons/"
cp basemaps.json "$app/basemaps.json"
cp experiments/ios-map/app/Info.plist "$app/Info.plist"
/usr/libexec/PlistBuddy -c "Add :CFBundleSupportedPlatforms array" "$app/Info.plist"
/usr/libexec/PlistBuddy -c "Add :CFBundleSupportedPlatforms:0 string $platform" "$app/Info.plist"
sdk="$(xcrun --sdk "$sdk_name" --show-sdk-path)"
xcrun --sdk "$sdk_name" swiftc -warnings-as-errors -parse-as-library -module-name TrailIosProbeHost -sdk "$sdk" \
    -target "$triple" \
    -F "$framework" -framework TrailIosProbe \
    -framework AVFoundation -framework CoreLocation -framework UIKit -framework CoreFoundation -framework CoreGraphics \
    -framework CoreText -framework Foundation -framework ImageIO \
    -framework Metal -framework QuartzCore -lc++ -lz -lsqlite3 \
    -Xlinker -ObjC \
    experiments/ios-map/app/*.swift ios/TrailPlatform/Sources/TrailPlatform/*.swift -o "$app/TrailIosProbe"
# Reuse the Android vector artwork for the iOS launcher icon.
python ios/make_app_icons experiments/ios-map/build/AppIcons.xcassets
icon_info="experiments/ios-map/build/icon-info-$kind.plist"
xcrun actool experiments/ios-map/build/AppIcons.xcassets --compile "$app" \
    --platform "$sdk_name" --target-device iphone --minimum-deployment-target 18.5 \
    --app-icon AppIcon --output-partial-info-plist "$icon_info"
python - "$app/Info.plist" "$icon_info" <<'PLIST'
import plistlib, sys
from pathlib import Path
path = Path(sys.argv[1])
info = plistlib.loads(path.read_bytes())
info.update(plistlib.loads(Path(sys.argv[2]).read_bytes()))
path.write_bytes(plistlib.dumps(info))
PLIST
# Device artifacts deliberately remain unsigned until a real team/profile is supplied.
if [ "$kind" = simulator ]; then
    # Permit only local fixture networking in simulator packages; device builds
    # retain ATS defaults and production downloads use HTTPS.
    /usr/libexec/PlistBuddy -c "Add :NSAppTransportSecurity dict" "$app/Info.plist"
    /usr/libexec/PlistBuddy -c "Add :NSAppTransportSecurity:NSAllowsLocalNetworking bool true" "$app/Info.plist"
    python experiments/ios-map/make_local_archive "$app/mapAssets/maps/ios-contours.pmtiles"
    codesign --force --sign - "$app"
fi
xcrun vtool -show-build "$app/TrailIosProbe"
